# LinkedIn Scraper Configuration
# Copy this file to .env and fill in your values

# Optional: Proxy settings for rate limiting
# PROXY_URL=http://user:pass@proxy.example.com:8080

# Optional: Maximum jobs to scrape per run (0 for unlimited)
# MAX_JOBS_PER_RUN=500

# Optional: Run browser in headless mode by default
# HEADLESS=false